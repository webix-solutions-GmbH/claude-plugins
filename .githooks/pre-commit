#!/usr/bin/env bash
# Knowledgebase nudge (non-blocking): warn when a mod's code is committed without touching a
# .docs/ note. Setup (one-time per clone):
#   git config core.hooksPath .githooks

if git diff --cached --name-only | grep -qE '^wbx-[^/]+/.*\.(ts|tsx)$' \
   && ! git diff --cached --name-only | grep -q '^\.docs/'; then
    echo "HINT: Commit touches a mod's code but no .docs/ note. If this changes documented behavior, update the affected note in this commit (see .docs/CONVENTIONS.md)."
fi

exit 0
